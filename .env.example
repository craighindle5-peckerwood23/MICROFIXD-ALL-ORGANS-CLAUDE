# Required for every protected operations endpoint. Use a long random value in deployment settings.
ADMIN_API_KEY=ab4859e526de243deb11a20fa57dead3f2bf17638d11345adc6e258cd6d1695b

# DEV_AUTH_BYPASS: local-development ONLY. When set to "true", every
# request is treated as admin -- no ADMIN_API_KEY is checked at all.
# Hard-locked server-side to refuse if NODE_ENV=production, and logs a
# loud boot warning whenever it's active. Does NOT affect approval-tiers
# governance -- writes/deploys/external effects still require real
# approval regardless of this flag. Leave unset/false for anything
# resembling production.
DEV_AUTH_BYPASS=false
# Optional RBAC: JSON object binding operator/viewer keys to separate
# credentials, e.g. {"operator":"...","viewer":"..."}. ADMIN_API_KEY
# above always resolves to the 'admin' role. Routes not yet gated by
# requireRole() accept any valid key at any role, same as before this
# was added -- see the comment above requireRole() in routes.ts for the
# current, honest list of which routes actually enforce a role.
MICROFIXD_ROLE_KEYS=

# Production durable system of record. For an IPv4-only container, use the Supabase Shared Pooler in Session mode.
# Copy the Session Pooler URI from Supabase Dashboard → Connect → Session Pooler, then place the real value only in .env.local or the deployment secret manager.
# Example format only — do not commit an actual password or URI:
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[PERCENT_ENCODED_PASSWORD]@aws-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=https://caiiajbxslllrgeexbaw.supabase.co/rest/v1/
# DATABASE_URL= # Equivalent portable Postgres variable; use one variable, not both.

# Production safety and runtime controls.
REQUIRE_DURABLE_MEMORY=true
MICROFIXD_EMERGENCY_STOP=false
MICROFIXD_MAX_PLAN_STEPS=25
MICROFIXD_MAX_COMPLETED_STEPS=25
# Disabled by default. When true, Puppeteer may capture only this service's local operations console; all external navigation is blocked.
MICROFIXD_ENABLE_LOCAL_SCREENSHOTS=false
MICROFIXD_CHROMIUM_PATH=/usr/bin/chromium
OMNIROUTER_MAX_AUTONOMOUS_COST_USD=0.02
REQUEST_BODY_LIMIT=256kb

# Optional local-only fallback; do not use this for multi-instance production deployments.
# MICROFIXD_STATE_FILE=./data/microfixd-state.json
# MICROFIXD_SANDBOX_DIR=./.microfixd/sandbox

# Optional: JSON array of allowlisted Plugin Registry manifests.
# Keep credentials in separately named environment variables referenced by a route's credentialHeader.env field.
# MICROFIXD_PLUGINS_JSON=[]

# Level-6 governed operation defaults. The global tenant remains available for backward-compatible internal work.
MICROFIXD_DEFAULT_TENANT=global
# Safe mode is persisted by the protected API. This variable is only an emergency process-level stop.
# No compute, browser, GitHub, CI/CD, or deployment adapter is enabled by these settings alone.
# Remote compute and web/source-control routes require an approved Plugin Registry manifest, OmniRouter routing, and Paragon/Craig review.
# NVIDIA_VISIBLE_DEVICES= # Read-only capability discovery only; no workload is scheduled without a governed adapter.
# Optional watchdog threshold: fraction of the real V8 heap limit, not transient allocated heap capacity.
MICROFIXD_WATCHDOG_HEAP_LIMIT_PRESSURE=0.90
